{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CV Maker",
  "version": "0.1.0",
  "identifier": "com.cvmaker.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "CV Maker — Resume Studio", "width": 1440, "height": 960, "minWidth": 900, "minHeight": 650 }],
    "security": { "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": "all", "category": "Productivity", "shortDescription": "Offline resume and CV maker" }
}
