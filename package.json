{
  "name": "cv-maker-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "tauri:build": "npm run icons:generate && npm run verify:icons && tauri build",
    "tauri:dev": "tauri dev",
    "check": "npm run typecheck && npm test && npm run build",
    "verify:icons": "node scripts/verify-tauri-icons.mjs",
    "icons:generate": "tauri icon public/cv-maker-logo.svg --output src-tauri/icons",
    "android:build": "npm run icons:generate && npm run verify:icons && tauri android build --apk"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2",
    "zod": "^3.24.1",
    "docx": "^9.1.0",
    "html-to-image": "^1.11.11",
    "@vnidrop/tauri-plugin-share": "^1.0.0-rc",
    "jspdf": "^3.0.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
